# Copie para backend/.env e preencha SPREADSHEET_ID (SPECS/02 secao 6).
# Este arquivo e versionado; o .env, nao.
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_PATH=../credentials.json
CACHE_TTL_SEGUNDOS=30
CORS_ORIGINS=http://localhost:4200
# Planilha separada para os testes de integracao (pytest -m integracao), lida
# daqui ou do terminal (o terminal vale mais). NUNCA a mesma de SPREADSHEET_ID:
# os testes apagam e recriam as abas do app nela. Vazia = testes pulados.
SPREADSHEET_ID_TESTE=
