# Copie para backend/.env e preencha SPREADSHEET_ID (SPECS/02 secao 6).
# Este arquivo e versionado; o .env, nao.
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_PATH=../credentials.json
CACHE_TTL_SEGUNDOS=30
CORS_ORIGINS=http://localhost:4200
# Planilha separada para os testes de integracao (pytest -m integracao), lida
# daqui ou do terminal (o terminal vale mais). NUNCA a mesma de SPREADSHEET_ID:
# os testes apagam e recriam as abas do app nela. Vazia = testes pulados.
SPREADSHEET_ID_TESTE=

# --- Importacao dos cartoes de credito pelo Meu Pluggy (opcional; SPECS/02 secao 11.2) ---
# Com as tres vazias a integracao fica desligada. O app so LE os dados da Pluggy.
# PLUGGY_CLIENT_SECRET e segredo: fica so no .env, nunca em log, teste ou no frontend.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# itemId de cada conexao MeuPluggy, separados por virgula (ex.: Itau e Nubank).
PLUGGY_ITEM_IDS=
# AAAA-MM-DD: desde quando buscar na primeira importacao de um cartao.
# Vazia = dia 1o do mes corrente.
PLUGGY_DATA_INICIAL=
# itemId de um item Sandbox, so para o teste de contrato (pytest -m pluggy).
PLUGGY_ITEM_ID_TESTE=
